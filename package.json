{
  "name": "vrc-ranking-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "stop": "powershell -NoProfile -File scripts/stop-local.ps1",
    "dev": "node scripts/dev.mjs",
    "dev:live": "node scripts/dev.mjs --live",
    "sync": "node scripts/vps.mjs sync",
    "collect": "node scripts/vps.mjs collect",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check public/app.js && node --check worker/index.js && python -m unittest discover -s tests -p test_*.py",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
